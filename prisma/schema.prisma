generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Carousel {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(255)
  picture   String   @db.VarChar(500)
  isOnline  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("carousel")
}

model Team {
  id        Int        @id @default(autoincrement())
  label     String     @db.VarChar(255)
  gender    Gender     @default(Masculin)
  isOnline  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  players   Player[]
  trainings Training[]

  @@map("team")
}

enum Gender {
  Masculin
  Feminin
  Mixte
}

model Player {
  id          Int       @id @default(autoincrement())
  firstname   String    @db.VarChar(100)
  lastname    String    @db.VarChar(100)
  position    String?   @db.VarChar(100)
  number      Int?
  photo       String?   @db.VarChar(500)
  teamId      Int
  dateOfBirth DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("player")
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(255)
  excerpt   String?  @db.Text
  content   String   @db.Text
  picture   String?  @db.VarChar(500)
  isOnline  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("post")
}

model Training {
  id        Int      @id @default(autoincrement())
  teamId    Int
  dayOfWeek Int
  startTime String   @db.VarChar(5)
  endTime   String   @db.VarChar(5)
  location  String?  @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("training")
}

model Contact {
  id        Int      @id @default(autoincrement())
  firstname String   @db.VarChar(100)
  lastname  String   @db.VarChar(100)
  email     String   @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  subject   String   @db.VarChar(255)
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("contact")
}

model User {
  id        Int      @id @default(autoincrement())
  firstname String   @db.VarChar(100)
  lastname  String   @db.VarChar(100)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("user")
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

model TrainingCenterRequest {
  id                 Int      @id @default(autoincrement())
  firstname          String   @db.VarChar(100)
  lastname           String   @db.VarChar(100)
  email              String   @db.VarChar(255)
  phone              String?  @db.VarChar(20)
  club               String   @db.VarChar(255)
  league             String   @db.VarChar(255)
  dates              String   @db.VarChar(255)
  playersCount       String   @db.VarChar(50)
  objectives         String[] @default([])
  services           String[] @default([])
  projectDescription String   @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@map("training_center_request")
}
